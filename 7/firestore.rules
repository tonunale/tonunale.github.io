rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Two-step explorer data: signed-in users can read; signed-in users can seed/update.
    match /regions/{regionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Contact Us uploads: signed-in users can create and read their own messages.
    match /contactMessages/{messageId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'email', 'topic', 'message', 'userId', 'userEmail', 'createdAt']);
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
